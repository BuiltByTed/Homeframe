{
  "name": "@builtbyted/vite",
  "version": "0.1.0",
  "private": true,
  "description": "Vite adapter for Homeframe metadata, icons, launch assets, manifest, bootstrap, and service worker.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --external vite --clean"
  },
  "dependencies": {
    "@builtbyted/runtime": "0.1.0",
    "@builtbyted/sw": "0.1.0",
    "sharp": "0.35.3"
  },
  "peerDependencies": {
    "vite": ">=7 <9"
  },
  "keywords": ["homeframe", "vite", "pwa", "manifest", "service-worker"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuiltByTed/Homeframe.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/BuiltByTed/Homeframe#readme",
  "bugs": { "url": "https://github.com/BuiltByTed/Homeframe/issues" },
  "publishConfig": { "access": "public" }
}
