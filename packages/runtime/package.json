{
  "name": "@builtbyted/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Homeframe viewport, safe-area, keyboard, lifecycle, install, and runtime event primitives.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean && cp src/styles.css dist/styles.css"
  },
  "keywords": ["homeframe", "pwa", "ios", "viewport", "keyboard"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuiltByTed/Homeframe.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/BuiltByTed/Homeframe#readme",
  "bugs": { "url": "https://github.com/BuiltByTed/Homeframe/issues" },
  "publishConfig": { "access": "public" }
}
