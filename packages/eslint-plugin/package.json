{
  "name": "@builtbyted/eslint-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "ESLint rules that protect Homeframe viewport, safe-area, and input ownership boundaries.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean"
  },
  "peerDependencies": {
    "eslint": ">=9 <11"
  },
  "keywords": ["homeframe", "eslint", "pwa", "ios", "viewport"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuiltByTed/Homeframe.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/BuiltByTed/Homeframe#readme",
  "bugs": { "url": "https://github.com/BuiltByTed/Homeframe/issues" },
  "publishConfig": { "access": "public" }
}
