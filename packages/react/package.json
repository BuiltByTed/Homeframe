{
  "name": "@homeframe/react",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["./dist/styles.css"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --sourcemap --external react --external react-dom --clean && cp src/styles.css dist/styles.css"
  },
  "dependencies": {
    "@homeframe/runtime": "0.1.0",
    "@homeframe/sw": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  }
}
