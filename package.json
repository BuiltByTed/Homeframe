{
  "name": "homeframe-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build:runtime": "npm run build -w @homeframe/runtime",
    "build:sw": "npm run build -w @homeframe/sw",
    "build:react": "npm run build -w @homeframe/react",
    "build:router": "npm run build -w @homeframe/router",
    "build:vite": "npm run build -w @homeframe/vite",
    "build:eslint": "npm run build -w @homeframe/eslint-plugin",
    "build:cli": "npm run build -w @homeframe/cli",
    "build:packages": "npm run build:runtime && npm run build:sw && npm run build:react && npm run build:router && npm run build:vite && npm run build:eslint && npm run build:cli",
    "build:example": "npm run build -w @homeframe/example",
    "build": "npm run build:packages && npm run build:example",
    "build:pages": "HOMEFRAME_BASE_PATH=/Homeframe/ VITE_HOMEFRAME_STATIC_DEMO=true npm run build && node scripts/prepare-pages.mjs",
    "dev": "npm run dev -w @homeframe/example",
    "preview": "npm run preview -w @homeframe/example",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:push": "node tests/push-smoke.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "doctor": "npm run build:packages && node packages/cli/dist/index.js doctor --root examples/kitchen-sink",
    "demo:serve": "node examples/kitchen-sink/server.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "sharp": "0.35.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "web-push": "3.6.7"
  }
}
