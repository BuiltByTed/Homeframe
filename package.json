{
  "name": "homeframe-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build:runtime": "npm run build -w @builtbyted/runtime",
    "build:sw": "npm run build -w @builtbyted/sw",
    "build:react": "npm run build -w @builtbyted/react",
    "build:router": "npm run build -w @builtbyted/router",
    "build:vite": "npm run build -w @builtbyted/vite",
    "build:eslint": "npm run build -w @builtbyted/eslint-plugin",
    "build:cli": "npm run build -w @builtbyted/cli",
    "build:homeframe": "npm run build -w @builtbyted/homeframe",
    "build:scaffold": "npm run build -w scaffold-homeframe-app",
    "build:packages": "npm run build:runtime && npm run build:sw && npm run build:react && npm run build:router && npm run build:vite && npm run build:eslint && npm run build:cli && npm run build:homeframe && npm run build:scaffold",
    "build:example": "npm run build -w @builtbyted/example",
    "build": "npm run build:packages && npm run build:example",
    "build:pages": "HOMEFRAME_BASE_PATH=/Homeframe/ VITE_HOMEFRAME_STATIC_DEMO=true npm run build && tsx scripts/prepare-pages.ts",
    "dev": "npm run dev -w @builtbyted/example",
    "preview": "npm run preview -w @builtbyted/example",
    "check:typescript": "tsx scripts/check-typescript.ts",
    "typecheck": "npm run check:typescript && tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:push": "tsx tests/push-smoke.ts",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "check:package": "tsx scripts/check-package-contract.ts",
    "doctor": "npm run build:packages && npm run check:package && node packages/cli/dist/index.js doctor --root examples/kitchen-sink",
    "release:check": "npm test && npm run doctor",
    "demo:serve": "tsx examples/kitchen-sink/server.ts",
    "clean": "tsx scripts/clean.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "sharp": "0.35.3",
    "tsup": "8.5.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "web-push": "3.6.7"
  }
}
